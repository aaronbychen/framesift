{
  "uid": "video-scanner",
  "title": "Video Scanner Serving",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Scan latency (end-to-end /analyze) P50 / P95 / P99",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{mode}} p50",
          "expr": "histogram_quantile(0.50, sum by (le, mode) (rate(scanner_scan_seconds_bucket[2m])))"
        },
        {
          "refId": "B",
          "legendFormat": "{{mode}} p95",
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(scanner_scan_seconds_bucket[2m])))"
        },
        {
          "refId": "C",
          "legendFormat": "{{mode}} p99",
          "expr": "histogram_quantile(0.99, sum by (le, mode) (rate(scanner_scan_seconds_bucket[2m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Per-frame inference latency P50 / P95 / P99",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{mode}} p50",
          "expr": "histogram_quantile(0.50, sum by (le, mode) (rate(scanner_inference_seconds_bucket[1m])))"
        },
        {
          "refId": "B",
          "legendFormat": "{{mode}} p95",
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(scanner_inference_seconds_bucket[1m])))"
        },
        {
          "refId": "C",
          "legendFormat": "{{mode}} p99",
          "expr": "histogram_quantile(0.99, sum by (le, mode) (rate(scanner_inference_seconds_bucket[1m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Throughput (frames/s analyzed)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{mode}} {{status}}",
          "expr": "sum by (mode, status) (rate(scanner_frames_total[30s]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Batching: mean items per model call / queue depth / in-flight frames",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(scanner_batch_size_sum[30s]) / rate(scanner_batch_size_count[30s])",
          "legendFormat": "mean batch size",
          "refId": "A",
          "datasource": null
        },
        {
          "expr": "scanner_queue_depth",
          "legendFormat": "queue depth",
          "refId": "B",
          "datasource": null
        },
        {
          "expr": "sum(scanner_inflight_inference)",
          "legendFormat": "in-flight frames",
          "refId": "C",
          "datasource": null
        }
      ]
    }
  ]
}